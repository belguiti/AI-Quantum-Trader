# ===================================================
# AI-Quantum-Trader - Environment Variables Template
# ===================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git!

# Database (SQL Server)
DB_PASSWORD=your_sqlserver_password

# API Keys
ALPHAVANTAGE_API_KEY=your_alphavantage_key
OPENAI_API_KEY=your_openai_api_key

# Authentication (JWT)
JWT_SECRET_KEY=your_jwt_secret_key_hex_64chars

# Docker SQL Server SA Password
SA_PASSWORD=your_sqlserver_sa_password
